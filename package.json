{
  "name": "side",
  "version": "0.1.0",
  "private": true,
  "description": "Side - set aside your tabs when you stop, step back inside with one tiny step when you return.",
  "main": "apps/desktop/dist/main.js",
  "workspaces": [
    "packages/*",
    "apps/*",
    "web/*"
  ],
  "scripts": {
    "build": "npm run build -w @side/extension && npm run build -w @side/desktop",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "npm run build -w @side/extension"
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  }
}
