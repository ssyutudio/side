<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 needs these under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Desktop apps (Connections): asks Word, Excel, PowerPoint or Photoshop to open a file, only when turned on. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- Calendar (Connections): reads tomorrow's first event time, only when turned on. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
</dict>
</plist>
